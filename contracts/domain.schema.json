{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "乡味月饼协作账领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "SUPPLIER_REGISTERED",
        "LOT_ACCEPTED",
        "LOT_INSPECTION_RECORDED",
        "WEIGHING_RECORDED",
        "RECIPE_VERSION_PUBLISHED",
        "WORKSHOP_CERTIFIED",
        "SHIFT_RECORDED",
        "LABOR_RECORDED",
        "BATCH_PRODUCED",
        "BATCH_RELEASED",
        "ORDER_RESERVED",
        "ORDER_ALLOCATED",
        "ORDER_REALLOCATED",
        "ORDER_CANCELLED",
        "RETURN_RECEIVED",
        "SHIPMENT_DISPATCHED",
        "SETTLEMENT_PAID",
        "RECALL_STARTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "supplier",
        "ingredient_lot",
        "recipe_version",
        "workshop",
        "shift",
        "production_batch",
        "sales_order",
        "shipment",
        "worker_settlement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
